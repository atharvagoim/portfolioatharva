# Admin panel PIN (default is admin123 if unset, so CHANGE THIS in production)
ADMIN_PIN=change-me

# Any long random string; signs admin login tokens
AUTH_SECRET=replace-with-a-long-random-string

# MongoDB Atlas connection string. Required on Vercel for the admin panel to save.
# Optional locally: without it, edits are saved to .data/db.json
MONGODB_URI=
# MONGODB_DB=portfolio
